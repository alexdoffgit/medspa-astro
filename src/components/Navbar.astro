      </a>
    </div>

    {/* Right Group: Action Button */}
    <div>
      <a 
        href="/consultation" 
        class="inline-flex items-center justify-center px-5 py-2 text-sm font-medium text-neutral-900 bg-neutral-100 hover:bg-neutral-200 rounded-full transition-colors"
